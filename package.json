{
  "name": "painel-governanca-ams-rh",
  "private": true,
  "version": "0.1.0",
  "description": "Painel de Governança AMS – Sistemas RH (projeto conceitual com dados fictícios)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "dados:resumo": "tsx --tsconfig tsconfig.scripts.json scripts/resumo-dados.ts",
    "planilhas:exemplo": "tsx --tsconfig tsconfig.scripts.json scripts/gerar-planilhas-exemplo.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "html-to-image": "1.11.13",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-grid-layout": "2.3.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "xlsx-js-style": "1.2.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
